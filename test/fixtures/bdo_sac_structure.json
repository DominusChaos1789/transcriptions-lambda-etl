{
  "contract_name": "ctl_trx_bdo_sac_transcripciones",
  "contract_type": "CATALOG",
  "file_process": "ctl_trx_bdo_sac_transcripciones",
  "file_group": "Catalogos",
  "client_prefix": "BDO",
  "operation_prefix": "SAC",
  "operation_segment": "Homologacion",
  "operation_process": "ConversacionesBot",
  "domain_name": "transcripciones",
  "enabled": true,
  "contract_version": "1.0.0",
  "genesys_cloud_organization": "org-3",

  "source": {
    "bucket_name": "providers-landing",
    "prefix_pattern": "external/datanexa/transacciones/empatia/transcripciones/BDO",
    "file_pattern": "*.json"
  },

  "format": {
    "allowed_types": [
      "json"
    ]
  },

  "columns": [
    {
      "position": 1,
      "name": "consumidor_tipo_id",
      "source_column": "client_dni_type",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 2,
      "name": "consumidor_id",
      "source_column": "client_dni",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": true,
      "hash": true,
      "encrypt": true
    },
    {
      "position": 3,
      "name": "consumidor_nombre",
      "source_column": "client_name",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": true,
      "hash": false,
      "encrypt": true
    },
    {
      "position": 4,
      "name": "consumidor_apellido",
      "source_column": "client_last_name",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": true,
      "hash": false,
      "encrypt": true
    },
    {
      "position": 5,
      "name": "consumidor_tipo_persona",
      "source_column": "person_type",
      "type": "string",
      "required": false,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 6,
      "name": "conversacion_id",
      "source_column": "genesys_cloud_id",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 7,
      "name": "interaccion_id",
      "source_column": "trace_id",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 8,
      "name": "interaccion_fecha_inicio",
      "source_column": "started_at",
      "type": "timestamp",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false,
      "input_formats": [
        "yyyy-MM-dd'T'HH:mm:ssXXX"
      ]
    },
    {
      "position": 9,
      "name": "interaccion_fecha_fin",
      "source_column": "exported_at",
      "type": "timestamp",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false,
      "input_formats": [
        "yyyy-MM-dd'T'HH:mm:ssXXX"
      ]
    },
    {
      "position": 10,
      "name": "interaccion_turnos",
      "source_column": "turns",
      "type": "integer",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 11,
      "name": "interaccion_resultado",
      "source_column": "interaction_result",
      "type": "string",
      "required": false,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 12,
      "name": "tenant_id",
      "source_column": "tenant_id",
      "type": "string",
      "required": true,
      "core": true,
      "sensitive": false,
      "hash": false,
      "encrypt": false
    },
    {
      "position": 13,
      "name": "mensajes",
      "source_column": "messages",
      "type": "json",
      "required": true,
      "core": true,
      "sensitive": true,
      "hash": false,
      "encrypt": true
    },
    {
      "position": 14,
      "name": "cliente_prefijo",
      "type": "string",
      "required": true,
      "core": true,
      "default_value": "BDO"
    },
    {
      "position": 15,
      "name": "operacion_prefijo",
      "type": "string",
      "required": true,
      "core": true,
      "default_value": "SAC"
    },
    {
      "position": 16,
      "name": "caso_uso_id",
      "type": "string",
      "required": true,
      "core": true,
      "default_value": "temporal_id"
    },
    {
      "position": 17,
      "name": "canal",
      "type": "string",
      "required": true,
      "core": false,
      "default_value": "VOICEBOT"
    },
    {
      "position": 18,
      "name": "origen",
      "type": "string",
      "required": true,
      "core": false,
      "default_value": "GENESYS_CLOUD"
    }
  ],

  "transformations": [
    {
      "type": "trim",
      "selector": "all-string"
    },
    {
      "type": "uppercase",
      "columns": [
        "consumidor_nombre",
        "consumidor_apellido",
        "consumidor_tipo_id",
        "cliente_prefijo",
        "operacion_prefijo"
      ]
    },
    {
      "type": "remove_accents",
      "selector": "all-string"
    }
  ],

  "quality": {
    "enable": true,
    "rules": [
      {
        "selector": "all-required",
        "rule_type": "not_null",
        "severity": "ERROR"
      },
      {
        "columns": [
          "consumidor_id"
        ],
        "rule_type": "numeric",
        "severity": "ERROR"
      },
      {
        "columns": [
          "conversacion_id"
        ],
        "rule_type": "uuid",
        "severity": "ERROR"
      },
      {
        "columns": [
          "interaccion_id"
        ],
        "rule_type": "unique",
        "severity": "ERROR"
      }
    ]
  },

  "encryption": {
    "enabled": true,
    "mode": "AES_GCM_ENVELOPE",
    "kms_key_alias": "alias/data-sensitive",
    "columns": [
      "consumidor_id",
      "consumidor_nombre",
      "consumidor_apellido",
      "mensajes"
    ],
    "aad_columns": [
      "cliente_prefijo",
      "operacion_prefijo",
      "operation_segment",
      "operation_process",
      "file_group"
    ]
  },

  "deduplication": {
    "enabled": true,
    "method": "DROP",
    "record_key": [
      "interaccion_id"
    ],
    "order_by": [
      "interaccion_fecha_fin"
    ],
    "order_type": [
      "desc"
    ]
  },

  "output": {
    "mode": "ICEBERG_DYNAMO",

    "iceberg": {
      "catalog": "transacciones",
      "database": "transcripciones",
      "table": "empatia",
      "partition_by": [
        "cliente_prefijo",
        "operacion_prefijo"
      ]
    },

    "dynamodb": {
      "enabled": true,
      "table": "interactions",
      "partition_key": [
        "interaccion_id"
      ],
      "sort_key": [
        "interaccion_fecha_inicio"
      ]
    }
  },

  "output_append": {
    "bucket_name": "refined",
    "prefix_pattern": "transacciones/empatia/transcripciones",
    "file_pattern": "parquet"
  }
}
